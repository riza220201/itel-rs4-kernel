# ── KernelSU-Next "Wild" (dev-susfs) + SusFS (ksunext variant) ──────────────────
# Current KernelSU-Next (restructured core/feature/hook/supercall) with SusFS — via
# pershoot's `dev-susfs` branch ("Wild KSU"), the maintained way the community
# (WildKernels) runs current KSU-Next + SusFS. Kernel-side is stock simonpunk SusFS
# (gki-android12-5.10) + pershoot's 2 extension cherry-picks (build-with-no-features +
# SuSFS/Toolkit coexistence). No `10_` patch — SusFS is in-driver on dev-susfs.
# Hooking is kprobes-based (KSU depends on KPROBES||SUSFS; stock has KPROBES=y).
# Self-contained driver → KMI stays 0x7c24b32d (gate checks).
#
# Versions are NOT written here (they rotted here twice): the pinned commits and the
# version the kernel reports (WILDKSU_VER_EXPECT, 30000 + rev-count of the merge-base
# with dev) live in sources.lock; the build log's "KernelSU-Next version:" line is
# the proof. Manager: the KernelSU-Next release the merge-base descends from.
# pershoot's KSU_SAMSUNG_{KDP,RKP,DEFEX,NO_PATCH_TEXT} keep their defaults (y): they
# detect Samsung by the root DT compatible and are inert on mediatek,MT6789.
CONFIG_KSU=y
CONFIG_KSU_SUSFS=y
CONFIG_KSU_SUSFS_SUS_PATH=y
CONFIG_KSU_SUSFS_SUS_MOUNT=y
CONFIG_KSU_SUSFS_SUS_KSTAT=y
CONFIG_KSU_SUSFS_SUS_MAP=y
CONFIG_KSU_SUSFS_SPOOF_UNAME=y
CONFIG_KSU_SUSFS_SPOOF_CMDLINE_OR_BOOTCONFIG=y
CONFIG_KSU_SUSFS_OPEN_REDIRECT=y
CONFIG_KSU_SUSFS_HIDE_KSU_SUSFS_SYMBOLS=y
CONFIG_KSU_SUSFS_ENABLE_LOG=y
