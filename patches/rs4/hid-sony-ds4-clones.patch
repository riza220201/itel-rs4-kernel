  * Request DS4 calibration data for the motion sensors.
  * For Bluetooth this also affects the operating mode (see below).
  */
+/*
+ * rs4: neutral DS4 calibration, for controllers whose calibration report is
+ * missing or unusable (third-party DS4s; see sony_input_configured()). Raw
+ * sensor values pass through scaled to the full s16 range; the important
+ * property is that no denominator is zero.
+ */
+static void dualshock4_set_default_calibration(struct sony_sc *sc)
+{
+	static const int codes[] = { ABS_RX, ABS_RY, ABS_RZ, ABS_X, ABS_Y, ABS_Z };
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(codes); i++) {
+		sc->ds4_calib_data[i].abs_code = codes[i];
+		sc->ds4_calib_data[i].bias = 0;
+		sc->ds4_calib_data[i].sens_numer = i < 3 ?
+			2 * DS4_GYRO_RES_PER_DEG_S : 2 * DS4_ACC_RES_PER_G;
+		sc->ds4_calib_data[i].sens_denom = S16_MAX;
+	}
+}
+
 static int dualshock4_get_calibration_data(struct sony_sc *sc)
 {
+	int i;
 	u8 *buf;
 	int ret;
 	short gyro_pitch_bias, gyro_pitch_plus, gyro_pitch_minus;
@@ -1713,6 +1735,15 @@
 	sc->ds4_calib_data[5].sens_numer = 2*DS4_ACC_RES_PER_G;
 	sc->ds4_calib_data[5].sens_denom = range_2g;
 
+	/* rs4: a report full of zeros would make dualshock4_parse_report() divide by zero */
+	for (i = 0; i < ARRAY_SIZE(sc->ds4_calib_data); i++) {
+		if (!sc->ds4_calib_data[i].sens_denom) {
+			hid_warn(sc->hdev, "DualShock 4 calibration report is invalid, using defaults\n");
+			dualshock4_set_default_calibration(sc);
+			break;
+		}
+	}
+
 err_stop:
 	kfree(buf);
 	return ret;
