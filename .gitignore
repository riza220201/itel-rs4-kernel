# build work dir + outputs (large, reproducible)
.build/
out/

# prebuilt clang toolchain (1.4G of binaries — never commit; run fetch-toolchain.sh)
toolchain/

# reference material dropped in the tree (not ours to redistribute)
*.zip
*.png
Screenshot*
*.mp4
*.mkv
*.webm
*.log

# stock firmware boot.img — device-specific OEM firmware, kept local (drop your
# own for --pack; the build reads $PROJ/boot.img by default)
*.img

# AnyKernel3 vendored copy keeps its files but not its git metadata
anykernel/.git/

# personal notes, plans, release drafts and release scripts (kept local):
# every .md except the root README (JOURNAL, RESUME, PLAN, TELEGRAM-POST*, sub-dir READMEs, ...)
*.md
!/README.md
release-*.sh
recreate-releases.sh

# local backups + python caches
backup/
__pycache__/
# device logs (personal data -- never in this public repo)
dmesg.txt
logcat.txt

# testers' DS4 captures (their controller + phone Bluetooth addresses): never publish
test/ds4/*.txt
